  "MD033": {
    "allowed_elements": [
      "a",
      "article",
      "br",
      "button",
      "code",
      "div",
      "em",
      "h1",
      "h2",
      "h3",
      "h4",
      "kbd",
      "li",
      "ol",
      "p",
      "section",
      "span",
      "strong",
      "ul"
    ]
  },
  "MD035": {
    "style": "---"
  },
  "MD040": true,
  "MD046": false,
  "MD048": {
    "style": "backtick"
  },
  "MD049": {
    "style": "asterisk"
  },
  "MD050": {
    "style": "asterisk"
  },
